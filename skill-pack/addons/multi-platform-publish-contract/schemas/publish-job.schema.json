{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Publish Job",
  "type": "object",
  "required": ["job_id", "asset_package_id", "asset_owner", "account_asset_package", "authorization", "status"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "asset_package_id": {"type": "string", "minLength": 1},
    "asset_owner": {"type": "string", "minLength": 1},
    "account_asset_package": {
      "type": "object",
      "required": ["account_key", "platform", "video_ref", "cover_ref", "caption"]
    },
    "authorization": {"type": "object"},
    "status": {
      "enum": ["draft", "ready_for_operator", "uploaded", "submitted", "scheduled", "published_verified", "blocked"]
    },
    "platform_result": {"type": ["object", "null"]}
  }
}
